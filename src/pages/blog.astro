---
import { getCollection } from 'astro:content';

const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const {title, url } = Astro.props;
const pageTitle = "Colorado Side Quests Event Blog";
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPosts.astro';
import Grid from '../components/Grid.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import ResourcesPreview from '../components/ResourcesPreview.astro'
import Skills from '../components/Skills.astro';

// Content Fetching: List four most recent work projects
const projects = (await getCollection('resources'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);


---
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <BaseLayout title={pageTitle}>
      <main class="wrapper stack gap-20 lg:gap-48">
			<section class="section with-background with-cta">
				<header class="section-header stack gap-1 lg:gap-2">
            <h2 class="section-title">Event Blog</h2>
        </header>
              <ul>
                {allPosts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title} />)}
              </ul>
      </section>
      <section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-2">
          <h3 class="section-title">Disclaimer</h3>
        </header>
            <div class="content">
              <p>These events are not hosted by or affiliated with Colorado Side Quests in any way shape or form. Acquainted Colorado does not endorse any group or organization tied to these events. You must do your own research about any event or organization you intend to participate in. You are responsible for your own safety both in-person and online. **Use any of the content on Acquainted Colorado at your own risk.**</p>
            </div>
      </section>
      </main>
				
				<div class="content">
          </div>
      </BaseLayout>

  </body>
</html>