---
import { getCollection } from 'astro:content';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import BlogPreview from '../components/BlogPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('resources')).sort(
	(b, a) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
	title="Blog"
	description="Resources to live your best life and pursue your passions."
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Resources"
				tagline="Resources to live your best life and pursue your passions."
				align="start"
			/>
			<Grid variant="offset">
				{
					projects.map((project) => (
						<li>
							<BlogPreview project={project} />
						</li>
					))
				}
			</Grid>
      <section>
      <h2>Disclaimer</h2>
      <p>These events are not hosted by or affiliated with Colorado Side Quests in any way shape or form. Colorado Side Quests does not endorse any group or organization tied to these events. You must do your own research about any event or organization you intend to participate in. You are responsible for your own safety both in-person and online. **Use any of the content on Colorado Side Quests at your own risk.**</p>
    </section>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>