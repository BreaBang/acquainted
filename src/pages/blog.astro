---

const allPosts = Object.values(import.meta.glob('../content/posts/*.md', { eager: true }));
const {title, url } = Astro.props;
const pageTitle = "My Astro Learning Blog";
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPosts.astro'; 
---
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <BaseLayout title={pageTitle}>
        <p>Blog Post List</p>
        <ul>
          {allPosts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title} />)}
        </ul>
    </BaseLayout>
    <section>
       <h2>
      Disclaimer
    </h2>
      <p>These events are not hosted by or affiliated with Colorado Side Quests in any way shape or form. Colorado Side Quests does not endorse any group or organization tied to these events. You must do your own research about any event or organization you intend to participate in. You are responsible for your own safety both in-person and online. **Use any of the content on Colorado Side Quests at your own risk.**
      </p>
    </section>
   

  </body>
</html>