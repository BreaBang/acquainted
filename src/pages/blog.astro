---

const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const {title, url } = Astro.props;
const pageTitle = "Event Blog";
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPosts.astro';
---
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <BaseLayout title={pageTitle}>
        <p>Event Blog</p>
        <ul>
          {allPosts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title} />)}
        </ul>
        <h2 class="section-title">Disclaimer</h2>
				<div class="content">
        <p>These events are not hosted by or affiliated with Acquainted Colorado in any way shape or form. Acquainted Colorado does not endorse any group or organization tied to these events. You must do your own research about any event or organization you intend to participate in. You are responsible for your own safety both in-person and online. **Use any of the content on Acquainted Colorado at your own risk.**</p>
    </div>
    <h2 class="section-title">For Event Hosts</h2>
    <p>Want to see your events listed? (Or want us to take your events off our list?) Let us know!</p>
				<div class="content">
          </div>
      </BaseLayout>

  </body>
</html>