---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="November Events | Side Quests Colorado" description="November 2026 Events">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="November 2026"
				tagline="Check out the cool events you can go to in November."
			>
				<img
					width="1553"
					height="873"
					src="/assets/november.jpg"
					alt="A group of elk in an orange aspen tree grove."
				/>
    </Hero>
<section>
				<h2 class="section-title">Write a Novel This Month (Previously called NaNoWriMo)</h2>
				<div class="content">
					<p>
						Coming soon
					</p>
				</div>
			</section>
<section>
				<h2 class="section-title">Walking</h2>
				<div class="content">
					<p>
						Coming soon
					</p>
				</div>
			</section>
<section>
				<h2 class="section-title">Biking</h2>
				<div class="content">
				<p>
						Coming soon
					</p>
				</div>
			</section>

- <a href="https://www.ravelry.com" target="_blank">Ravelry</a>: Great website to find free patterns, buy used yarn and supplies and meet other yarn people.

<section>
				<h2 class="section-title">Yoga</h2>
				<div class="content">
			<p>
						Coming soon
					</p>
				</div>
			</section>
<section>
				<h2 class="section-title">Other In-Person</h2>
				<div class="content">
					<p>
						Coming soon
					</p>
				</div>
			</section>
<section>
				<h2 class="section-title">Other Virtual</h2>
				<div class="content">
				<p>
						Coming soon
					</p>
				</div>
			</section>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>