---
import BaseLayout from "../../layouts/BaseLayout.astro"
import ContactCTA from "../../components/ContactCTA.astro"
import Hero from "../../components/Hero.astro"
---
<BaseLayout title="November Events | Side Quests Colorado" description="November 2026 Events">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="November 2026 Walking and Hiking Events"
				tagline="Check out the cool events you can go to in November."
			>
				<img
					width="1553"
					height="873"
					src="/assets/november.jpg"
					alt="A group of elk in an orange aspen tree grove."
				/>
    </Hero>
<section>
		<h2 class="section-title">Walking Events (by Groups hosting)</h2>
		<div class="content">
			<h3>Birding Walk</h3>
				<p>Nov 14 at 8 AM to 11 AM in Littleton</p>
				<p>See the <a href="https://www.instagram.com/p/DfQLpCOj62V/?img_index=1" target="_blank">@denver.audubon IG Post</a>for more info</p>
		</div>
		<div class="content">
			<h3>Water-wise Birding Walk</h3>
				<p>Nov 14 at 9 AM to 10:30 AM in Aurora</p>
				<p>See the <a href="https://www.instagram.com/p/DfQLpCOj62V/?img_index=1" target="_blank">@denver.audubon IG Post</a>for more info</p>
		</div>
		<div class="content">
			<h3>Hike with Outdoor Asian CO</h3>
				<p>Nov 15 at 10 AM</p>
				<p>See the <a href="https://www.instagram.com/p/De2KLDCoJ42/" target="_blank">@outdoorasiancolorado IG Post</a>for more info</p>
		</div>
		<div class="content">
			<h3>Colorado Queer Walk in the Park</h3>
				<p>Nov 15 at 9 AM</p>
				<p>Location: Wash Park 39°41'35.5"N 104°58'06.9"W
Intersection of Louisiana & Franklin</p>
				<p>See the <a href="https://www.instagram.com/p/Des4A3mDY8r/?img_index=1" target="_blank">@queerumbrella IG Post</a></p>
		</div>
		<div class="content">
			<h3>Denver Sapphic Walks (for lesbians, bi ladies, queers, enbys)</h3>
				<p>
					<ul>
						<li>Nov 1 Wash Park</li>
						<li>Nov 8 Cheesman Park</li>
						<li>Sloan's Lake</li>
						<li>City Park</li>
						<li>Fairmount Cemetery</li>
					</ul>
				</p>
				<p>Optional coffee meetup at 9:15, then meet at the park around 9:45 & start walking at 10.</p>
				<p>Follow <a href="https://www.instagram.com/p/DfAzNhcByhe/" target="_blank">@denverwlwalks</a> for more info.</p>
		</div>
			</section>
<section>
				<h2 class="section-title">Disclaimers</h2>
				<div class="content">
				<p>
						Colorado Side Quests does not endorse any of the events, organizations and individuals listed on this page or on our site. The information provided is information only. Attend any event at your own risk. Neither Colorado Side Quests, nor it's contributors are not responsible for your health, safety or wellbeing and will not be held responsible for any real or percieved injuries you face after attending any of the events listed on our site or by using any third-party links on our site. We cannot control you or any third-party individual or organization or their website. Use the Colorado Side Quests website or Instagram at your own risk.
				</p>
				</div>
			</section>
      </main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		h3 {
			font-size: medium;
		}
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>