---
import BaseLayout from "../../layouts/BaseLayout.astro"
import ContactCTA from "../../components/ContactCTA.astro"
import Hero from "../../components/Hero.astro"
---
<BaseLayout title="December Holiday Market Events | Side Quests Colorado" description="December 2026 Holiday Markets">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="December 2026 Holiday Markets"
				tagline="Holiday Markets for local shopping."
			>
				<img
					width="1553"
					height="873"
					src="/assets/holidaymarket.png"
					alt="A woman looking at a christmas stocking in a store."
				/>
    </Hero>
	<section>
		<h2 class="section-title">Colorado Holiday Markets</h2>
						<p class="space-p">Remember to check with the organizaer before attending. Some events are free and others require a ticket to be purchased in advance. We tried to put correct ticket and RSVP links but you are responsible for verifying the accuracy of information before purchasing tickets.</p>
			<div class="content">
				<h3>Dec 3: Grand Holiday Market in Denver</h3>
				<p><b>Time:</b> 4 PM -7 PM</p>
				<p><b>Location:</b> 1750 Welton St, Denver, CO 80202</p>
				<p>Learn More: <a href="https://www.instagram.com/p/Df6AGkaFDCW/?img_index=1" target="_blank">@grandhyattdenver IG post</a></p>
			</div>
			<div class="content">
				<h3>Dec 4-6: Colorado Springs Holiday Food and Gift Festival</h3>
				<p><b>Time: </b>10 AM - 5PM (Starts at 11 AM Friday, Ends 4 PM Sunday)</p>
				<p><b>Location: </b>1045 Lower Gold Camp Rd, Colorado Springs, CO 80905</p>
				<p>Get a ticket:<a href="https://www.eventbrite.com/e/28th-annual-colorado-springs-holiday-food-gift-festival-dec-4th-6th-tickets-2003620340374?aff=oddtdtcreator" target="_blank"></a>Eventbrite</p>
			</div>
			<div class="content">
				<h3>Dec 5: Vegan Holiday Market in Boulder</h3>
				<p><b>Time:</b> 11 AM - 3 PM</p>
				<p><b>Location: </b>Avalon Ballroom 6185 Arapahoe RoadBoulder, CO, 80303</p>
				<p>LLearn More: <a href="https://www.vegfestco.com/upcoming-events/event-two-ftcpy-32dx7-h6rz6-m6y73-kp92l" target="_blank">VFCO Webpage</a></p>
			</div>
			<div class="content">
				<h3>Dec 5-6: Wings & Wonder Holiday Gift Market</h3>
				<p class="space-p"><b>Time:</b> 9 AM - 2 PM<b>Location:</b>11280 Waterton Rd, Littleton, CO 80125</p>
				<p>Get a Ticket: <a href="https://denveraudubon.app.neoncrm.com/nx/portal/neonevents/events?path=%2Fportal%2Fevents%2F61974" target="_blank">Registration Website</a></p>
			</div>
			<div class="content">
				<h3>Dec 5-6: Georgetown Christmas Market</h3>
				<p><b>Time: </b>Hours not posted</p>
				<p><b>Location: </b>Georgetown, CO 80444</p>
				<p>Learn More:<a href="https://historicgeorgetown.org/georgetown-christmas-market-2/" target="_blank"> Historic George Town Website</a></p>
			</div>
			<div class="content">
				<h3>Dec 6: Fort Collins Holiday Gift Festival</h3>
				<p><b>Time: </b>11 AM - 5 PM</p>
				<p><b>Location: </b>Northside Aztlan Center 112 E Willow St, Fort Collins</p>
				<p>Learn More:<a href="https://www.coloradoevents.org/fortcollins-holiday-gift-festival" target="_blank">Event Website</a></p>
			</div>
			<div class="content">
				<h3>Dec 10-13: Vail Kris Kringle Market</h3>
				<p><b>Time: </b>12:30 PM - 4:30 PM</p>
				<p><b>Location: </b>Lionsehead and Vail Village</p>
				<p>Learn More:<a href="https://www.vailfarmersmarket.com/" target="_blank">Event Website</a></p>
			</div>
			<div class="content">
				<h3>Dec 12-13: HoliGay Market</h3>
				<p><b>Time: </b>11 AM - 5 PM</p>
				<p><b>Location: </b>1660 N Federal Blvd Denver, CO 80204</p>
				<p>Learn More:<a href="https://www.facebook.com/events/west-denver/denver-holigay-market-2026/1383068534034058/" target="_blank">Facebook Post</a></p>
			</div>
			<div class="content">
				<h3>Dec 12-13: Georgetown Christmas Market</h3>
				<p><b>Time: </b>Hours not posted</p>
				<p><b>Location: </b>Georgetown, CO 80444</p>
				<p>Learn More:<a href="https://historicgeorgetown.org/georgetown-christmas-market-2/" target="_blank"> Historic George Town Website</a></p>
			</div>
			<div class="content">
				<h3>Dec 13: Vegan Holiday Market Denver</h3>
				<p><b>Time: </b>1 PM - 5 PM</p>
				<p><b>Location: </b>Dry Clean Only 3358 York St, Denver, CO 80205</p>
				<p>Learn More:<a href="https://www.vegfestco.com/upcoming-events/wdyfgeixqfemim06qr08gn1zktgxnm-s725n" target="_blank">VFCO Denver Website</a></p>
			</div>
			<div class="content">
				<h3>Dec 13: Hmong Holiday Arts, Crafts & More Show</h3>
				<p><b>Time: </b>2:30 PM - 5 PM</p>
				<p><b>Location: </b>12001 Oakland St, CO 80022-8009</p>
				<p>Learn More:<a href="https://allevents.in/henderson/2nd-annual-hmong-holiday-arts-crafts-and-more-show/200031010091443" target="_blank">Event Post</a></p>
			</div>
	</section>
	<section>
				<h2 class="section-title">Disclaimers</h2>
					<div class="content">
						<p>
							Colorado Side Quests does not endorse any of the events, organizations and individuals listed on this page or on our site. The information provided is information only. Attend any event at your own risk. Neither Colorado Side Quests, nor it's contributors are not responsible for your health, safety or wellbeing and will not be held responsible for any real or percieved injuries you face after attending any of the events listed on our site or by using any third-party links on our site. We cannot control you or any third-party individual or organization or their website. Use the Colorado Side Quests website or Instagram at your own risk.
						</p>
					</div>
			</section>
      </main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.space-p{
		padding-bottom: 1rem;
	}
	h3 {
		font-size: 1.25rem;
	}
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>